# ---------------------------------------------------------------------------
# Agent Fleet environment config
# Copy this file to `.env` and fill in your own values.
# The app runs WITHOUT these (local-only mode); they enable cloud sync + login.
# ---------------------------------------------------------------------------

# Supabase project URL, e.g. https://abcdefgh.supabase.co
# Find it in: Supabase dashboard -> Project Settings -> Data API -> Project URL
VITE_SUPABASE_URL=

# Supabase "anon" (public) key. Safe to ship in the app BECAUSE RLS is enabled.
# Find it in: Supabase dashboard -> Project Settings -> API Keys -> anon public
VITE_SUPABASE_ANON_KEY=

# Where git worktrees for agent tasks are created on disk.
# Defaults to a folder next to each project if left blank.
FLEET_WORKTREE_ROOT=

# Optional: absolute path to the `claude` executable.
# Leave blank to auto-detect from PATH.
FLEET_CLAUDE_PATH=
